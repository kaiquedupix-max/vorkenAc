PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/vorken
DATABASE_SSL=false
SESSION_SECRET=change-this-long-random-value
ADMIN_PASSWORD=change-this-password
PUBLIC_URL=https://vorken.example.com
AGENT_BINARY_PATH=/app/agent-build/Vorken.Agent.exe

# Conta inicial do app administrativo de suporte remoto.
# Use pelo menos 12 caracteres e remova a senha do ambiente após o primeiro cadastro.
REMOTE_ADMIN_BOOTSTRAP_USER=administrador
REMOTE_ADMIN_BOOTSTRAP_NAME=Administrador Vorken
REMOTE_ADMIN_BOOTSTRAP_PASSWORD=

# Consulta de contas Steam detectadas no computador pela API oficial da Steam.
# A chave fica somente no backend; nunca é embutida no agente.
STEAM_WEB_API_KEY=

# Server Armour: usa a Server Key do seu servidor cadastrado em serverarmour.com.
# Mantida apenas no backend do Vorken.
SERVER_ARMOUR_KEY=
