PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/vorken
DATABASE_SSL=false
SESSION_SECRET=change-this-long-random-value
ADMIN_PASSWORD=change-this-password
PUBLIC_URL=https://vorken.example.com
AGENT_BINARY_PATH=/app/agent-build/Vorken.Agent.exe

# A revisão por IA faz parte do fluxo padrão de toda análise.
# Se a API falhar, o resultado técnico continua disponível no painel.
AI_REVIEW_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
AI_REVIEW_BATCH_SIZE=12
AI_FALSE_POSITIVE_THRESHOLD=0.85
# 0 = sem limite. Se quiser controlar custo, informe o máximo de findings revisados por análise.
AI_REVIEW_MAX_FINDINGS=0
