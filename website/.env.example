PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/vorken
DATABASE_SSL=false
SESSION_SECRET=change-this-long-random-value
ADMIN_PASSWORD=change-this-password
PUBLIC_URL=https://vorken.example.com
AGENT_BINARY_PATH=/app/agent-build/Vorken.Agent.exe

# Segunda camada de revisão por Gemini.
# A chave pode ser criada no Google AI Studio.
# Se a API falhar ou atingir o limite gratuito, o filtro técnico normal continua disponível.
AI_REVIEW_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=60000
AI_REVIEW_BATCH_SIZE=20
AI_FALSE_POSITIVE_THRESHOLD=0.85
# 0 = sem limite de findings revisados por análise.
AI_REVIEW_MAX_FINDINGS=0

# Consulta de contas Steam detectadas no computador pela API oficial da Steam.
# A chave fica somente no backend; nunca é embutida no agente.
STEAM_WEB_API_KEY=

