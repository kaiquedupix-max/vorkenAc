<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Vorken.Agent</AssemblyName>
    <RootNamespace>Vorken.Agent</RootNamespace>
    <Version>1.0.17</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/vorken.ico</ApplicationIcon>
    <Title>Vorken AntiCheat</Title>
    <Product>Vorken AntiCheat</Product>
    <Company>Vorken</Company>
    <Description>Consent-based defensive forensic scanner for competitive game investigations.</Description>
    <Copyright>Copyright © Vorken 2026</Copyright>
    <AssemblyVersion>1.0.17.0</AssemblyVersion>
    <FileVersion>1.0.17.0</FileVersion>
    <InformationalVersion>1.0.17</InformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Prefetch" Version="2026.5.2" />
    <PackageReference Include="Amcache" Version="2026.5.3" />
    <PackageReference Include="AppCompatCache" Version="1.2.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/analysis-token-slot.txt" LogicalName="Vorken.AnalysisToken" />
  </ItemGroup>

</Project>
