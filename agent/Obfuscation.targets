<Project>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <Target Name="ObfuscateAgentForBundle" AfterTargets="PrepareForBundle" BeforeTargets="_GenerateSingleFileBundleInputCache"
          Condition="'$(Configuration)' == 'Release' and '$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <_ObfuscationDotnet Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_ObfuscationDotnet>
      <_ObfuscationDotnet Condition="'$(_ObfuscationDotnet)' == ''">dotnet</_ObfuscationDotnet>
      <_ObfuscationRoot>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)obfuscation'))</_ObfuscationRoot>
      <_ObfuscationInput>$(_ObfuscationRoot)/input</_ObfuscationInput>
      <_ObfuscationOutput>$(_ObfuscationRoot)/output</_ObfuscationOutput>
      <_ObfuscationConfig>&lt;Obfuscator&gt;
&lt;Var name="InPath" value="$(_ObfuscationInput)" /&gt;
&lt;Var name="OutPath" value="$(_ObfuscationOutput)" /&gt;
&lt;Var name="KeepPublicApi" value="true" /&gt;
&lt;Var name="HidePrivateApi" value="true" /&gt;
&lt;Var name="HideStrings" value="false" /&gt;
&lt;Var name="RenameProperties" value="false" /&gt;
&lt;Var name="RenameEvents" value="false" /&gt;
&lt;Var name="RenameFields" value="false" /&gt;
&lt;Var name="UseUnicodeNames" value="false" /&gt;
&lt;Var name="SkipGenerated" value="true" /&gt;
&lt;Var name="OptimizeMethods" value="false" /&gt;
&lt;Var name="SuppressIldasm" value="false" /&gt;
&lt;Module file="$(_ObfuscationInput)/$(TargetFileName)"&gt;
&lt;SkipProperty type="*" name="*" /&gt;
&lt;SkipField type="*" name="*" /&gt;
&lt;SkipType name="Vorken.Agent.AgentMainForm*" skipMethods="true" skipFields="true" skipProperties="true" skipEvents="true" /&gt;
&lt;SkipType name="^.*AnonymousType.*" skipMethods="true" skipFields="true" skipProperties="true" /&gt;
&lt;/Module&gt;
&lt;/Obfuscator&gt;</_ObfuscationConfig>
    </PropertyGroup>
    <MakeDir Directories="$(_ObfuscationInput);$(_ObfuscationOutput)" />
    <ItemGroup>
      <_ObfuscationDependency Include="@(FilesToBundle)" Condition="'%(Extension)' == '.dll'" />
      <_OriginalAgentBundle Include="@(FilesToBundle)" Condition="'%(Filename)%(Extension)' == '$(TargetFileName)'" />
    </ItemGroup>
    <Error Condition="'@(_OriginalAgentBundle)' == ''" Text="Agent assembly missing from bundle; refusing an unprotected release." />
    <Copy SourceFiles="@(_ObfuscationDependency)" DestinationFolder="$(_ObfuscationInput)" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(_ObfuscationRoot)/obfuscar.xml" Lines="$(_ObfuscationConfig)" Overwrite="true" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/.." Command="&quot;$(_ObfuscationDotnet)&quot; tool run obfuscar.console -- &quot;$(_ObfuscationRoot)/obfuscar.xml&quot;" />
    <Error Condition="!Exists('$(_ObfuscationOutput)/$(TargetFileName)')" Text="Obfuscation did not produce the agent assembly." />
    <ItemGroup>
      <FilesToBundle Remove="@(_OriginalAgentBundle)" />
      <FilesToBundle Include="$(_ObfuscationOutput)/$(TargetFileName)">
        <RelativePath>$(TargetFileName)</RelativePath>
      </FilesToBundle>
    </ItemGroup>
  </Target>
</Project>
